# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# API de Sanity (solo servidor)
SANITY_API_READ_TOKEN=
# Token independiente seguro para el navegador para la vista previa en vivo de Sanity en modo borrador (obligatorio)
SANITY_API_BROWSER_TOKEN=
# Secreto para habilitar el modo borrador (NO debe ser el token de lectura)
SANITY_DRAFT_SECRET=
# Secreto utilizado por el webhook de Sanity que apunta a /api/revalidate
SANITY_REVALIDATE_SECRET=

# Resend (formulario de contacto)
RESEND_API_KEY=

# Contacto
CONTACT_RECIPIENT_EMAIL=correo@gmail.com

# Sitio
NEXT_PUBLIC_SITE_URL=https://tepexidigital.com.mx

# Analíticas opcionales
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Upstash Redis — limitación de tasa compartida (obligatorio en producción y vista previa)
KV_REST_API_URL=
KV_REST_API_TOKEN=